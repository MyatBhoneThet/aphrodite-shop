# Public Supabase project values (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server aliases and server-only administrator key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public URL used in receipt email links
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional digital receipt email (the printable website receipt works without these)
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Aphrodite Myanmar <receipts@your-verified-domain.com>
RECEIPT_CURRENCY=MMK
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Google Sheets product sync. The shared APD workbook is the built-in default;
