# Public Supabase project values (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server aliases and server-only administrator key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public URL of this site. Used in receipt email links, in the password reset
# link, and to build the Google sign-in callback -- so it must match the site
# exactly (https in production), and the callback below must be allow-listed in
# Supabase under Authentication -> URL Configuration -> Redirect URLs:
#   <APP_URL>/api/auth/oauth/callback
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in ("Continue with Google") needs no keys here: the Client ID and
# Secret are entered in the Supabase dashboard, under
# Authentication -> Providers -> Google. See "Google sign-in" in README.md.

# Optional digital receipt email (the printable website receipt works without these)
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Aphrodite Myanmar <receipts@your-verified-domain.com>
RECEIPT_CURRENCY=MMK
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Google Sheets product sync. The shared APD workbook is the built-in default;
# set GOOGLE_SHEETS_SPREADSHEET_ID only when you want to use another workbook.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=1bQ3SVyRh5CD20JKCX-YWv0M30NdpTCafIfoDEI8NlN4
