# Public Supabase project values (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server aliases and server-only administrator key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public URL of this site. Used in receipt email links, in the password reset
# link, and to build every social sign-in callback -- so it must match the site
# exactly (https in production), and the callbacks below must be allow-listed:
#   <APP_URL>/api/auth/oauth/callback       (Supabase -> Authentication ->
#                                            URL Configuration -> Redirect URLs)
#   <APP_URL>/api/auth/oauth/line/callback  (LINE Developers -> your channel ->
#                                            LINE Login -> Callback URL)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The address customers should see in links sent to their inbox: the order
# receipt, the "track your order" button and the password-reset link.
#
# Leave it unset in production -- it falls back to APP_URL. Set it in
# .env.local when your development server talks to the LIVE database, because
# marking an order delivered there emails a real customer, and APP_URL would
# put http://localhost:3000 in front of them.
# PUBLIC_SITE_URL=https://your-production-domain

# Google and Facebook sign-in need no keys here: their Client ID / App ID and
# secret are entered in the Supabase dashboard, under
# Authentication -> Providers. See "Social sign-in" in README.md.

# LINE sign-in. Supabase has no LINE provider, so this app is the OAuth client
# itself and needs the channel's own credentials, from LINE Developers ->
# your Login channel -> Basic settings. Leave both blank to hide the LINE
# button. The channel also needs LINE's "Email address permission", or LINE
# returns no address and the sign-in cannot complete.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Optional: which social buttons to show, comma separated, from google,
# facebook and line. Unset means every provider whose credentials are present.
# SOCIAL_LOGIN_PROVIDERS=google,facebook,line

# Optional digital receipt email (the printable website receipt works without these)
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Aphrodite Myanmar <receipts@your-verified-domain.com>
RECEIPT_CURRENCY=MMK
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Google Sheets product sync. The shared APD workbook is the built-in default;
# set GOOGLE_SHEETS_SPREADSHEET_ID only when you want to use another workbook.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=1bQ3SVyRh5CD20JKCX-YWv0M30NdpTCafIfoDEI8NlN4
